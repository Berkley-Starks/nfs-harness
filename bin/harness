#!/usr/bin/env bash
###############################################################################
# harness — the control wrapper. "Replace yourself with a small shell script."
#
# Orchestrates the two planes so a test cycle is two commands:
#
#   ./harness obs-up         # bring up Prometheus/Grafana (survives everything)
#   ./harness up --clients 5 # stand up backend + fleet, mount NFS, start load
#   ...watch Grafana...
#   ./harness down           # destroy the test plane; instruments stay up
#   ./harness obs-down       # park observability compute (metrics volume kept)
#
# Layer split is preserved: terraform owns infra, ansible owns config. This
# script only sequences them and wires terraform output -> ansible inventory.
#
# Runs in a POSIX env (WSL / Linux) with terraform, ansible-playbook, aws, jq
# on PATH. See bin/bootstrap-wsl.sh to provision that env.
###############################################################################
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
TF_DIR="$ROOT/terraform"
OBS_DIR="$TF_DIR/observability"
ANSIBLE_DIR="$ROOT/ansible"

TF="${TERRAFORM:-terraform}"
SSH_KEY="${HARNESS_SSH_KEY:-$HOME/.ssh/nfs-harness.pem}"

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_ylw=$'\033[33m'; c_rst=$'\033[0m'
say()  { echo "${c_grn}==>${c_rst} $*"; }
warn() { echo "${c_ylw}!! ${c_rst} $*" >&2; }
die()  { echo "${c_red}xx ${c_rst} $*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1"; }

# cd into the module in a subshell rather than passing `-chdir=<path>`: a native
# (Windows) terraform.exe under MSYS/Git Bash mangles the path argument, whereas
# the shell's own `cd` handles every environment's path style. Equivalent to
# -chdir (terraform's relative paths resolve against the module dir either way).
tf()     { ( cd "$TF_DIR" && "$TF" "$@" ); }
tf_obs() { ( cd "$OBS_DIR" && "$TF" "$@" ); }

###############################################################################
# inventory: terraform output -> ansible/inventory/hosts.ini
###############################################################################
gen_inventory() {
  need jq
  local json; json="$(tf output -json)"
  local inv="$ANSIBLE_DIR/inventory/hosts.ini"
  mkdir -p "$ANSIBLE_DIR/inventory"

  local private; private="$(echo "$json" | jq -r '.private_networking.value // false')"

  if [ "$private" = "true" ]; then
    # Private posture: no public IPs, no SSH. Ansible reaches each box over SSM
    # using its INSTANCE ID as the host, staging modules through the S3 bucket.
    local bucket region
    bucket="$(echo "$json" | jq -r '.ssm_bucket.value // empty')"
    region="$(echo "$json" | jq -r '.region.value // "us-east-1"')"
    {
      echo "# generated by bin/harness — do not edit (SSM mode)"
      echo "[clients]"
      local i=0
      while read -r id; do
        [ -n "$id" ] || continue
        echo "client-$i ansible_host=$id"
        i=$((i + 1))
      done < <(echo "$json" | jq -r '.client_instance_ids.value[]?')

      local server_id; server_id="$(echo "$json" | jq -r '.server_instance_id.value // empty')"
      if [ -n "$server_id" ] && [ "$server_id" != "null" ]; then
        echo ""
        echo "[nfs_server]"
        echo "nfs-server ansible_host=$server_id"
      fi

      echo ""
      echo "[all:vars]"
      echo "ansible_connection=aws_ssm"
      echo "ansible_aws_ssm_bucket_name=$bucket"
      echo "ansible_aws_ssm_region=$region"
    } > "$inv"
  else
    # Public posture: SSH to the admin_cidr-gated public IPs (the cheap default).
    {
      echo "# generated by bin/harness — do not edit"
      echo "[clients]"
      local i=0
      while read -r ip; do
        [ -n "$ip" ] || continue
        echo "client-$i ansible_host=$ip"
        i=$((i + 1))
      done < <(echo "$json" | jq -r '.client_public_ips.value[]?')

      local server_ip; server_ip="$(echo "$json" | jq -r '.server_public_ip.value // empty')"
      if [ -n "$server_ip" ]; then
        echo ""
        echo "[nfs_server]"
        echo "nfs-server ansible_host=$server_ip"
      fi

      echo ""
      echo "[all:vars]"
      echo "ansible_user=ec2-user"
    } > "$inv"
  fi

  say "wrote inventory: $inv"
}

###############################################################################
# configure: run ansible against the live fleet
###############################################################################
configure() {
  need ansible-playbook

  local json; json="$(tf output -json)"
  local endpoint export_path backend private dsx
  endpoint="$(echo "$json"   | jq -r '.nfs_endpoint.value // empty')"
  export_path="$(echo "$json"| jq -r '.nfs_export_path.value // "/"')"
  backend="$(echo "$json"    | jq -r '.nfs_backend_selected.value')"
  private="$(echo "$json"    | jq -r '.private_networking.value // false')"
  dsx="$(echo "$json"        | jq -r '.dsx_mode.value // false')"
  [ -n "$endpoint" ] || die "nfs_endpoint is empty — is the test plane up?"

  gen_inventory

  # Connection-specific setup: SSM needs no key (and no SSH wait); the public
  # posture SSHes to the fleet's admin-gated public IPs.
  local conn_args=()
  if [ "$private" = "true" ]; then
    need session-manager-plugin
    say "private posture: Ansible over SSM (no SSH); waiting for SSM agents to register..."
    sleep 30
  else
    [ -f "$SSH_KEY" ] || die "SSH key not found: $SSH_KEY (set HARNESS_SSH_KEY)"
    conn_args=(--private-key "$SSH_KEY")
    say "waiting for SSH on the fleet..."
    sleep 20  # let cloud-init + sshd settle; ansible retries below cover the rest
  fi

  say "configuring fleet (node_exporter, mount $endpoint:$export_path, workload)"
  # ANSIBLE_CONFIG is set explicitly because a world-writable cwd (e.g. a /mnt/c
  # WSL mount) makes Ansible silently ignore ./ansible.cfg — which would drop the
  # inventory and skip every play. -i is passed directly for the same reason.
  ( cd "$ANSIBLE_DIR" && \
    ANSIBLE_CONFIG="$ANSIBLE_DIR/ansible.cfg" ANSIBLE_HOST_KEY_CHECKING=False \
    ansible-playbook -i "$ANSIBLE_DIR/inventory/hosts.ini" site.yml \
      "${conn_args[@]}" \
      -e "nfs_endpoint=$endpoint" \
      -e "nfs_export_path=$export_path" \
      -e "nfs_backend=$backend" \
      -e "dsx_mode=$dsx" \
      -T 30 )
  say "fleet configured; workload running"
}

###############################################################################
# commands
###############################################################################
cmd_up() {
  # Per-run knobs as flags so you never edit tfvars to change a run. Each accepts
  # both "--flag value" and "--flag=value". Anything not passed falls back to the
  # terraform variable defaults (nfs_backend=efs, client_instance_type=t3.small,
  # client_count=3) or your tfvars (ssh key, admin_cidr, capacity, profile).
  local extra=() key val
  while [ $# -gt 0 ]; do
    if [ "$1" = "--no-config" ]; then NO_CONFIG=1; shift; continue; fi
    # Skip the cluster placement group (a benchmark-correctness feature). Handy
    # for light spot testing and when the deploy policy lacks
    # ec2:CreatePlacementGroup or spot capacity in a PG is tight.
    if [ "$1" = "--no-pg" ]; then extra+=("-var" "enable_placement_group=false"); shift; continue; fi
    # Co-locate the client fleet in the cluster placement group too (not just the
    # server). Needs a non-burstable client type (the c5n.large default qualifies);
    # removes placement as a variable when comparing per-client behavior.
    if [ "$1" = "--cluster-clients" ]; then extra+=("-var" "cluster_clients=true"); shift; continue; fi
    # Hardened posture: private fleet subnet, NAT egress, SSM access (no public
    # IPs, no SSH). Needs the private-mode IAM + session-manager-plugin locally.
    if [ "$1" = "--private" ]; then extra+=("-var" "private_networking=true"); shift; continue; fi
    if [[ "$1" == *=* ]]; then key="${1%%=*}"; val="${1#*=}"; shift
    else key="$1"; val="${2:-}"; shift 2; fi
    case "$key" in
      --nfs|--backend)   extra+=("-var" "nfs_backend=$val") ;;          # efs | self_managed
      --instance)        extra+=("-var" "client_instance_type=$val") ;; # client fleet size, e.g. t3.small
      --server-instance) extra+=("-var" "server_instance_type=$val") ;; # self-managed server size
      --clients)         extra+=("-var" "client_count=$val") ;;
      # --capacity sets BOTH tiers in one switch (the common case: a whole run
      # spot for light testing, or on_demand for a clean benchmark). The per-tier
      # flags override it when they differ — put them AFTER --capacity (last
      # -var for a variable wins).
      --capacity)        extra+=("-var" "client_capacity_type=$val" "-var" "server_capacity_type=$val") ;; # spot | on_demand
      --client-capacity) extra+=("-var" "client_capacity_type=$val") ;; # spot | on_demand (client tier only)
      --server-capacity) extra+=("-var" "server_capacity_type=$val") ;; # spot | on_demand (server tier only)
      *) die "unknown flag to up: $key" ;;
    esac
  done

  need "$TF"
  # Pre-flight the config toolchain BEFORE creating any AWS resources. Running
  # `up` from a shell without ansible-playbook/jq (e.g. Git Bash on Windows)
  # would otherwise stand up a billed fleet it can't configure. Fail fast unless
  # configuration was explicitly skipped.
  if [ "${NO_CONFIG:-0}" != "1" ]; then
    command -v ansible-playbook >/dev/null 2>&1 || die "ansible-playbook not found — run the harness under WSL/Linux (see docs/SETUP_GUIDE.md), or pass --no-config to stand up infra only."
    command -v jq >/dev/null 2>&1 || die "jq not found — run under WSL/Linux, or pass --no-config."
  fi
  tf init -input=false >/dev/null
  say "applying test plane..."
  tf apply -input=false -auto-approve -var test_plane_enabled=true "${extra[@]}"
  tf output

  if [ "${NO_CONFIG:-0}" = "1" ]; then
    warn "--no-config: skipping ansible. Run './harness configure' when ready."
  else
    configure
  fi
  say "up complete. Grafana: $(tf_obs output -raw grafana_url 2>/dev/null || echo 'run obs-up')"
}

cmd_configure() { configure; }

cmd_down() {
  need "$TF"
  say "destroying test plane (instruments + network stay up)..."
  tf apply -input=false -auto-approve -var test_plane_enabled=false
  say "test plane down. Observability + metrics volume untouched."
}

cmd_obs_up() {
  need "$TF"
  tf_obs init -input=false >/dev/null
  say "bringing observability compute up..."
  tf_obs apply -input=false -auto-approve -var observability_running=true
  say "Grafana: $(tf_obs output -raw grafana_url)"
  say "Prometheus: $(tf_obs output -raw prometheus_url)"
}

cmd_obs_down() {
  need "$TF"
  say "parking observability compute (metrics volume preserved)..."
  tf_obs apply -input=false -auto-approve -var observability_running=false
  say "observability compute down. Volume $(tf_obs output -raw metrics_volume_id) kept."
}

cmd_status() {
  echo "=== test plane ==="
  tf output 2>/dev/null || echo "(no state)"
  echo ""
  echo "=== observability ==="
  tf_obs output 2>/dev/null || echo "(no state)"
}

cmd_plan() { tf init -input=false >/dev/null; tf plan -var test_plane_enabled=true "$@"; }

cmd_destroy_all() {
  warn "Full teardown of BOTH roots. The metrics EBS volume has prevent_destroy"
  warn "and will block this until you consciously remove it. That is intentional."
  read -r -p "type 'destroy' to proceed: " ans
  [ "$ans" = "destroy" ] || die "aborted"
  tf_obs destroy -auto-approve || warn "obs destroy blocked (likely prevent_destroy on the volume)"
  tf destroy -auto-approve
}

usage() {
  cat <<USAGE
harness — ephemeral NFS test harness control

  up [flags]     stand up the test plane, mount NFS, start the workload.
                 Per-run flags (also accept --flag=value); unset = terraform defaults:
                   --nfs efs|self_managed     backend            (default efs)
                   --instance TYPE            client fleet size  (default t3.small)
                   --clients N                fleet count        (default 3)
                   --capacity spot|on_demand  purchase option, BOTH tiers
                   --client-capacity VAL      override client tier only
                   --server-capacity VAL      override server tier only
                   --server-instance TYPE     self-managed server size
                   --no-pg                    skip the cluster placement group
                   --cluster-clients          also place the client fleet in the cluster PG (non-burstable type)
                   --private                  hardened posture (private subnet + NAT + SSM, no public IPs)
                   --no-config                skip the ansible step
                 e.g.  ./harness up --nfs=self_managed --clients=10 --capacity=spot
                 e.g.  ./harness up --capacity=spot --server-capacity=on_demand
  configure      (re)run ansible against the current fleet
  down           destroy the test plane (keep observability + network + guardrail)
  obs-up         bring up Prometheus/Grafana (independent lifecycle)
  obs-down       park observability compute; persistent metrics volume kept
  status         show outputs for both planes
  plan           terraform plan the test plane
  destroy-all    tear everything down (guarded; EBS prevent_destroy applies)

Env: HARNESS_SSH_KEY (default ~/.ssh/nfs-harness.pem), TERRAFORM (default 'terraform')
USAGE
}

case "${1:-}" in
  up)          shift; cmd_up "$@" ;;
  configure)   shift; cmd_configure "$@" ;;
  down)        shift; cmd_down "$@" ;;
  obs-up)      shift; cmd_obs_up "$@" ;;
  obs-down)    shift; cmd_obs_down "$@" ;;
  status)      shift; cmd_status "$@" ;;
  plan)        shift; cmd_plan "$@" ;;
  destroy-all) shift; cmd_destroy_all "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
