#!/usr/bin/env bash
###############################################################################
# harness — the control wrapper. "Replace yourself with a small shell script."
#
# Orchestrates the two planes so a test cycle is two commands:
#
#   ./harness obs-up         # bring up Prometheus/Grafana (survives everything)
#   ./harness up --clients 5 # stand up backend + fleet, mount NFS, start load
#   ...watch Grafana...
#   ./harness down           # destroy the test plane; instruments stay up
#   ./harness obs-down       # park observability compute (metrics volume kept)
#
# Layer split is preserved: terraform owns infra, ansible owns config. This
# script only sequences them and wires terraform output -> ansible inventory.
#
# Runs in a POSIX env (WSL / Linux) with terraform, ansible-playbook, aws, jq
# on PATH. See bin/bootstrap-wsl.sh to provision that env.
###############################################################################
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
TF_DIR="$ROOT/terraform"
OBS_DIR="$TF_DIR/observability"
ANSIBLE_DIR="$ROOT/ansible"

TF="${TERRAFORM:-terraform}"
SSH_KEY="${HARNESS_SSH_KEY:-$HOME/.ssh/nfs-harness.pem}"

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_ylw=$'\033[33m'; c_rst=$'\033[0m'
say()  { echo "${c_grn}==>${c_rst} $*"; }
warn() { echo "${c_ylw}!! ${c_rst} $*" >&2; }
die()  { echo "${c_red}xx ${c_rst} $*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1"; }

tf()     { "$TF" -chdir="$TF_DIR" "$@"; }
tf_obs() { "$TF" -chdir="$OBS_DIR" "$@"; }

###############################################################################
# inventory: terraform output -> ansible/inventory/hosts.ini
###############################################################################
gen_inventory() {
  need jq
  local json; json="$(tf output -json)"
  local inv="$ANSIBLE_DIR/inventory/hosts.ini"
  mkdir -p "$ANSIBLE_DIR/inventory"

  {
    echo "# generated by bin/harness — do not edit"
    echo "[clients]"
    local i=0
    while read -r ip; do
      [ -n "$ip" ] || continue
      echo "client-$i ansible_host=$ip"
      i=$((i + 1))
    done < <(echo "$json" | jq -r '.client_public_ips.value[]?')

    local server_ip; server_ip="$(echo "$json" | jq -r '.server_public_ip.value // empty')"
    if [ -n "$server_ip" ]; then
      echo ""
      echo "[nfs_server]"
      echo "nfs-server ansible_host=$server_ip"
    fi

    echo ""
    echo "[all:vars]"
    echo "ansible_user=ec2-user"
  } > "$inv"

  say "wrote inventory: $inv"
}

###############################################################################
# configure: run ansible against the live fleet
###############################################################################
configure() {
  need ansible-playbook
  [ -f "$SSH_KEY" ] || die "SSH key not found: $SSH_KEY (set HARNESS_SSH_KEY)"

  local json; json="$(tf output -json)"
  local endpoint export_path backend
  endpoint="$(echo "$json"   | jq -r '.nfs_endpoint.value // empty')"
  export_path="$(echo "$json"| jq -r '.nfs_export_path.value // "/"')"
  backend="$(echo "$json"    | jq -r '.nfs_backend_selected.value')"
  [ -n "$endpoint" ] || die "nfs_endpoint is empty — is the test plane up?"

  gen_inventory

  say "waiting for SSH on the fleet..."
  sleep 20  # let cloud-init + sshd settle; ansible retries below cover the rest

  say "configuring fleet (node_exporter, mount $endpoint:$export_path, workload)"
  ( cd "$ANSIBLE_DIR" && ansible-playbook site.yml \
      --private-key "$SSH_KEY" \
      -e "nfs_endpoint=$endpoint" \
      -e "nfs_export_path=$export_path" \
      -e "nfs_backend=$backend" \
      -T 30 )
  say "fleet configured; workload running"
}

###############################################################################
# commands
###############################################################################
cmd_up() {
  local extra=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --clients)  extra+=("-var" "client_count=$2"); shift 2 ;;
      --backend)  extra+=("-var" "nfs_backend=$2"); shift 2 ;;
      --capacity) extra+=("-var" "client_capacity_type=$2"); shift 2 ;;
      --no-config) NO_CONFIG=1; shift ;;
      *) die "unknown flag to up: $1" ;;
    esac
  done

  need "$TF"
  tf init -input=false >/dev/null
  say "applying test plane..."
  tf apply -input=false -auto-approve -var test_plane_enabled=true "${extra[@]}"
  tf output

  if [ "${NO_CONFIG:-0}" = "1" ]; then
    warn "--no-config: skipping ansible. Run './harness configure' when ready."
  else
    configure
  fi
  say "up complete. Grafana: $(tf_obs output -raw grafana_url 2>/dev/null || echo 'run obs-up')"
}

cmd_configure() { configure; }

cmd_down() {
  need "$TF"
  say "destroying test plane (instruments + network stay up)..."
  tf apply -input=false -auto-approve -var test_plane_enabled=false
  say "test plane down. Observability + metrics volume untouched."
}

cmd_obs_up() {
  need "$TF"
  tf_obs init -input=false >/dev/null
  say "bringing observability compute up..."
  tf_obs apply -input=false -auto-approve -var observability_running=true
  say "Grafana: $(tf_obs output -raw grafana_url)"
  say "Prometheus: $(tf_obs output -raw prometheus_url)"
}

cmd_obs_down() {
  need "$TF"
  say "parking observability compute (metrics volume preserved)..."
  tf_obs apply -input=false -auto-approve -var observability_running=false
  say "observability compute down. Volume $(tf_obs output -raw metrics_volume_id) kept."
}

cmd_status() {
  echo "=== test plane ==="
  tf output 2>/dev/null || echo "(no state)"
  echo ""
  echo "=== observability ==="
  tf_obs output 2>/dev/null || echo "(no state)"
}

cmd_plan() { tf init -input=false >/dev/null; tf plan -var test_plane_enabled=true "$@"; }

cmd_destroy_all() {
  warn "Full teardown of BOTH roots. The metrics EBS volume has prevent_destroy"
  warn "and will block this until you consciously remove it. That is intentional."
  read -r -p "type 'destroy' to proceed: " ans
  [ "$ans" = "destroy" ] || die "aborted"
  tf_obs destroy -auto-approve || warn "obs destroy blocked (likely prevent_destroy on the volume)"
  tf destroy -auto-approve
}

usage() {
  cat <<USAGE
harness — ephemeral NFS test harness control

  up [--clients N] [--backend efs|self_managed] [--capacity spot|on_demand] [--no-config]
                 stand up the test plane, mount NFS, start the workload
  configure      (re)run ansible against the current fleet
  down           destroy the test plane (keep observability + network + guardrail)
  obs-up         bring up Prometheus/Grafana (independent lifecycle)
  obs-down       park observability compute; persistent metrics volume kept
  status         show outputs for both planes
  plan           terraform plan the test plane
  destroy-all    tear everything down (guarded; EBS prevent_destroy applies)

Env: HARNESS_SSH_KEY (default ~/.ssh/nfs-harness.pem), TERRAFORM (default 'terraform')
USAGE
}

case "${1:-}" in
  up)          shift; cmd_up "$@" ;;
  configure)   shift; cmd_configure "$@" ;;
  down)        shift; cmd_down "$@" ;;
  obs-up)      shift; cmd_obs_up "$@" ;;
  obs-down)    shift; cmd_obs_down "$@" ;;
  status)      shift; cmd_status "$@" ;;
  plan)        shift; cmd_plan "$@" ;;
  destroy-all) shift; cmd_destroy_all "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
