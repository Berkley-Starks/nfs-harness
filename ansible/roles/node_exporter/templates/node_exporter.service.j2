[Unit]
Description=Prometheus node_exporter (NFS harness)
After=network-online.target
Wants=network-online.target

[Service]
User={{ node_exporter_user }}
Group={{ node_exporter_user }}
Type=simple
# The ethtool collector reads NIC driver stats (the ENA allowance counters) via a
# privileged ioctl. Grant just CAP_NET_ADMIN to the otherwise-unprivileged
# service so those metrics populate without running node_exporter as root.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
ExecStart=/usr/local/bin/node_exporter {{ node_exporter_extra_flags }}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
