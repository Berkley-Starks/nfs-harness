{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "Ec2BuildAndWireUnconditioned",
			"Effect": "Allow",
			"Action": [
				"ec2:CreateVpc",
				"ec2:CreateSubnet",
				"ec2:CreateInternetGateway",
				"ec2:AttachInternetGateway",
				"ec2:CreateRouteTable",
				"ec2:CreateRoute",
				"ec2:AssociateRouteTable",
				"ec2:CreateSecurityGroup",
				"ec2:AuthorizeSecurityGroupIngress",
				"ec2:AuthorizeSecurityGroupEgress",
				"ec2:CreateLaunchTemplate",
				"ec2:CreateLaunchTemplateVersion",
				"ec2:RunInstances",
				"ec2:CreateVolume",
				"ec2:AttachVolume",
				"ec2:DetachVolume",
				"ec2:CreateNetworkInterface",
				"ec2:DeleteNetworkInterface",
				"ec2:ModifyNetworkInterfaceAttribute",
				"ec2:CreatePlacementGroup",
				"ec2:CancelSpotInstanceRequests",
				"ec2:AllocateAddress",
				"ec2:CreateNatGateway",
				"ec2:AssociateIamInstanceProfile",
				"ec2:ReplaceIamInstanceProfileAssociation",
				"ec2:CreateTags"
			],
			"Resource": "*"
		},
		{
			"Sid": "Ec2DestroyAndModifyTagged",
			"Effect": "Allow",
			"Action": [
				"ec2:DeleteVpc",
				"ec2:DeleteSubnet",
				"ec2:DeleteInternetGateway",
				"ec2:DetachInternetGateway",
				"ec2:DeleteRouteTable",
				"ec2:DeleteRoute",
				"ec2:DisassociateRouteTable",
				"ec2:DeleteSecurityGroup",
				"ec2:RevokeSecurityGroupIngress",
				"ec2:RevokeSecurityGroupEgress",
				"ec2:ModifySecurityGroupRules",
				"ec2:DeleteLaunchTemplate",
				"ec2:DeleteLaunchTemplateVersions",
				"ec2:TerminateInstances",
				"ec2:StopInstances",
				"ec2:StartInstances",
				"ec2:ModifyInstanceAttribute",
				"ec2:ModifyVpcAttribute",
				"ec2:ModifySubnetAttribute",
				"ec2:DeleteVolume",
				"ec2:DeletePlacementGroup",
				"ec2:ReleaseAddress",
				"ec2:DeleteNatGateway",
				"ec2:DisassociateIamInstanceProfile",
				"ec2:DeleteTags"
			],
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"aws:ResourceTag/Project": "nfs-harness"
				}
			}
		},
		{
			"Sid": "EfsCreateTagged",
			"Effect": "Allow",
			"Action": [
				"elasticfilesystem:CreateFileSystem",
				"elasticfilesystem:TagResource",
				"elasticfilesystem:CreateTags"
			],
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"aws:RequestTag/Project": "nfs-harness"
				}
			}
		},
		{
			"Sid": "EfsMountTargetsUnconditioned",
			"Effect": "Allow",
			"Action": [
				"elasticfilesystem:CreateMountTarget",
				"elasticfilesystem:DeleteMountTarget"
			],
			"Resource": "*"
		},
		{
			"Sid": "EfsModifyDeleteTagged",
			"Effect": "Allow",
			"Action": [
				"elasticfilesystem:DeleteFileSystem",
				"elasticfilesystem:PutLifecycleConfiguration",
				"elasticfilesystem:UntagResource"
			],
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"aws:ResourceTag/Project": "nfs-harness"
				}
			}
		},
		{
			"Sid": "IamLambdaEventsScoped",
			"Effect": "Allow",
			"Action": [
				"iam:CreateInstanceProfile",
				"lambda:CreateFunction",
				"lambda:TagResource",
				"iam:UntagRole",
				"iam:TagRole",
				"events:PutRule",
				"iam:RemoveRoleFromInstanceProfile",
				"iam:CreateRole",
				"iam:AttachRolePolicy",
				"iam:PutRolePolicy",
				"lambda:UntagResource",
				"iam:AddRoleToInstanceProfile",
				"iam:PassRole",
				"iam:DetachRolePolicy",
				"iam:DeleteRolePolicy",
				"lambda:DeleteFunction",
				"events:RemoveTargets",
				"iam:DeleteInstanceProfile",
				"lambda:UpdateFunctionConfiguration",
				"iam:DeleteRole",
				"lambda:UpdateFunctionCode",
				"events:TagResource",
				"events:DeleteRule",
				"events:PutTargets",
				"lambda:AddPermission",
				"lambda:RemovePermission",
				"events:UntagResource"
			],
			"Resource": [
				"arn:aws:iam::*:role/nfs-harness-*",
				"arn:aws:iam::*:instance-profile/nfs-harness-*",
				"arn:aws:lambda:*:*:function:nfs-harness-*",
				"arn:aws:events:*:*:rule/nfs-harness-*"
			]
		},
		{
			"Sid": "ReadOnly",
			"Effect": "Allow",
			"Action": [
				"iam:GetRole",
				"iam:GetRolePolicy",
				"iam:GetInstanceProfile",
				"iam:ListInstanceProfiles",
				"iam:ListInstanceProfilesForRole",
				"iam:ListAttachedRolePolicies",
				"iam:ListRolePolicies",
				"elasticfilesystem:Describe*",
				"elasticfilesystem:ListTagsForResource",
				"lambda:List*",
				"lambda:Get*",
				"events:Describe*",
				"events:List*",
				"ec2:Describe*",
				"ec2:GetSecurityGroupsForVpc",
				"sts:GetCallerIdentity"
			],
			"Resource": "*"
		},
		{
			"Sid": "SpotServiceLinkedRole",
			"Effect": "Allow",
			"Action": "iam:CreateServiceLinkedRole",
			"Resource": "arn:aws:iam::*:role/aws-service-role/spot.amazonaws.com/AWSServiceRoleForEC2Spot",
			"Condition": {
				"StringEquals": {
					"iam:AWSServiceName": "spot.amazonaws.com"
				}
			}
		},
		{
			"Sid": "PrivateNetworkingSsmBucket",
			"Effect": "Allow",
			"Action": [
				"s3:CreateBucket",
				"s3:DeleteBucket",
				"s3:ListBucket",
				"s3:GetBucketLocation",
				"s3:GetBucketTagging",
				"s3:PutBucketTagging",
				"s3:PutBucketPublicAccessBlock",
				"s3:GetBucketPublicAccessBlock",
				"s3:PutEncryptionConfiguration",
				"s3:GetEncryptionConfiguration",
				"s3:GetObject",
				"s3:PutObject",
				"s3:DeleteObject"
			],
			"Resource": [
				"arn:aws:s3:::nfs-harness-ssm-*",
				"arn:aws:s3:::nfs-harness-ssm-*/*"
			]
		},
		{
			"Sid": "PrivateNetworkingSsmSessions",
			"Effect": "Allow",
			"Action": [
				"ssm:StartSession",
				"ssm:TerminateSession",
				"ssm:ResumeSession",
				"ssm:DescribeSessions",
				"ssm:GetConnectionStatus",
				"ssm:DescribeInstanceInformation"
			],
			"Resource": "*"
		}
	]
}
