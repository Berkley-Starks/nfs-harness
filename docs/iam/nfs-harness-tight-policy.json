{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "VisualEditor0",
			"Effect": "Allow",
			"Action": [
				"ec2:DetachVolume",
				"ec2:AttachVolume",
				"ec2:AuthorizeSecurityGroupEgress",
				"ec2:AuthorizeSecurityGroupIngress",
				"ec2:CreateVpc",
				"ec2:CreateRouteTable",
				"ec2:RunInstances",
				"ec2:AttachInternetGateway",
				"ec2:CreateLaunchTemplateVersion",
				"ec2:CreateVolume",
				"ec2:AssociateRouteTable",
				"ec2:RevokeSecurityGroupIngress",
				"ec2:CreateLaunchTemplate",
				"ec2:CreateRoute",
				"ec2:CreateSecurityGroup",
				"ec2:CreateInternetGateway",
				"ec2:RevokeSecurityGroupEgress",
				"ec2:CreateSubnet"
			],
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"aws:RequestTag/Project": "nfs-harness"
				}
			}
		},
		{
			"Sid": "VisualEditor1",
			"Effect": "Allow",
			"Action": [
				"ec2:DeleteSubnet",
				"ec2:DeleteLaunchTemplate",
				"ec2:TerminateInstances",
				"ec2:DeleteRoute",
				"ec2:ModifySecurityGroupRules",
				"ec2:DetachInternetGateway",
				"ec2:StopInstances",
				"ec2:DisassociateRouteTable",
				"ec2:DeleteRouteTable",
				"ec2:DeleteVolume",
				"ec2:StartInstances",
				"ec2:DeleteSecurityGroup",
				"ec2:DeleteInternetGateway",
				"ec2:DeleteVpc",
				"ec2:DeleteLaunchTemplateVersions",
				"ec2:ModifyInstanceAttribute",
				"ec2:ModifyVpcAttribute",
				"ec2:ModifySubnetAttribute"
			],
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"aws:ResourceTag/Project": "nfs-harness"
				}
			}
		},
		{
			"Sid": "VisualEditor2",
			"Effect": "Allow",
			"Action": [
				"ec2:DeleteTags",
				"ec2:CreateTags"
			],
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"aws:RequestTag/Project": "nfs-harness"
				}
			}
		},
		{
			"Sid": "VisualEditor3",
			"Effect": "Allow",
			"Action": [
				"elasticfilesystem:UntagResource",
				"elasticfilesystem:CreateMountTarget",
				"elasticfilesystem:CreateFileSystem",
				"elasticfilesystem:PutLifecycleConfiguration",
				"elasticfilesystem:DeleteMountTarget",
				"elasticfilesystem:DeleteFileSystem",
				"elasticfilesystem:TagResource",
				"elasticfilesystem:CreateTags"
			],
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"aws:RequestTag/Project": "nfs-harness"
				}
			}
		},
		{
			"Sid": "VisualEditor4",
			"Effect": "Allow",
			"Action": [
				"iam:CreateInstanceProfile",
				"lambda:CreateFunction",
				"lambda:TagResource",
				"iam:UntagRole",
				"iam:TagRole",
				"events:PutRule",
				"iam:RemoveRoleFromInstanceProfile",
				"iam:CreateRole",
				"iam:AttachRolePolicy",
				"iam:PutRolePolicy",
				"lambda:UntagResource",
				"iam:AddRoleToInstanceProfile",
				"iam:PassRole",
				"iam:DetachRolePolicy",
				"iam:DeleteRolePolicy",
				"lambda:DeleteFunction",
				"events:RemoveTargets",
				"iam:DeleteInstanceProfile",
				"lambda:UpdateFunctionConfiguration",
				"iam:DeleteRole",
				"lambda:UpdateFunctionCode",
				"events:TagResource",
				"events:DeleteRule",
				"events:PutTargets",
				"lambda:AddPermission",
				"lambda:RemovePermission",
				"events:UntagResource"
			],
			"Resource": [
				"arn:aws:iam::*:role/nfs-harness-*",
				"arn:aws:iam::*:instance-profile/nfs-harness-*",
				"arn:aws:lambda:*:*:function:nfs-harness-*",
				"arn:aws:events:*:*:rule/nfs-harness-*"
			]
		},
		{
			"Sid": "VisualEditor5",
			"Effect": "Allow",
			"Action": [
				"iam:GetRole",
				"iam:GetRolePolicy",
				"elasticfilesystem:Describe*",
				"elasticfilesystem:ListTagsForResource",
				"iam:GetInstanceProfile",
				"lambda:List*",
				"lambda:Get*",
				"iam:ListInstanceProfiles",
				"events:Describe*",
				"iam:ListInstanceProfilesForRole",
				"ec2:Describe*",
				"iam:ListAttachedRolePolicies",
				"ec2:GetSecurityGroupsForVpc",
				"sts:GetCallerIdentity",
				"events:List*",
				"iam:ListRolePolicies"
			],
			"Resource": "*"
		},
		{
			"Sid": "VisualEditor6SpotSLR",
			"Effect": "Allow",
			"Action": "iam:CreateServiceLinkedRole",
			"Resource": "arn:aws:iam::*:role/aws-service-role/spot.amazonaws.com/AWSServiceRoleForEC2Spot",
			"Condition": {
				"StringEquals": {
					"iam:AWSServiceName": "spot.amazonaws.com"
				}
			}
		}
	]
}
