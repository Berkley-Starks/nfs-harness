# Copy to terraform.tfvars and fill in. Values without defaults are required.

# --- Required ---------------------------------------------------------------
ssh_key_name = "nfs-harness"        # name of your EC2 key pair
admin_cidr   = "YOUR.IP.HERE/32"    # run: curl -s ifconfig.me  then append /32

# --- Common overrides -------------------------------------------------------
region = "us-east-1"
# Least-privilege user by default. If terraform fails on a missing IAM action,
# temporarily switch to the broad user to unblock, then tighten the policy:
#   aws_profile = "nfs-harness-broad"
aws_profile = "nfs-harness-tight"

# Per-run knobs are FLAGS on `harness up` — no need to edit this file to change them:
#   ./bin/harness up --nfs self_managed --instance t3.medium --clients 10
# Unset, they fall back to the terraform defaults: nfs_backend=efs,
# client_instance_type=t3.small, client_count=3. Pin one here only if you want a
# different *default* for plain `terraform apply`.
# nfs_backend          = "efs"
# client_instance_type = "t3.small"
# client_count         = 3

# Capacity types default to spot in code; on_demand here is the safe env default
# (spot needs the EC2-Spot service-linked role). Override per run with --capacity.
client_capacity_type = "on_demand"
server_capacity_type = "on_demand"
