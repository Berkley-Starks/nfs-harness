#!/bin/bash
###############################################################################
# Observability box bootstrap.
#
# Idempotent + re-attach safe: the persistent EBS volume is formatted only if it
# has no filesystem yet, so a fresh obs-up onto an existing metrics volume keeps
# every prior data point. Prometheus TSDB and Grafana DB both live on /data,
# which IS that volume — the instance is cattle, the data is a pet.
###############################################################################
set -euxo pipefail
exec > >(tee -a /var/log/obs-bootstrap.log) 2>&1

############################ 1. mount metrics volume ##########################
# The attached EBS shows up as a second NVMe disk. Pick the one disk that has no
# partitions/filesystem-in-use as root: the data disk is the NVMe device that is
# not currently mounted at /.
ROOT_DISK="$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" | head -1)"
DATA_DISK=""
for _try in $(seq 1 30); do
  for d in $(lsblk -dno NAME -e7); do          # -e7 skips loop devices
    [ "$d" = "$ROOT_DISK" ] && continue
    DATA_DISK="/dev/$d"
    break
  done
  [ -n "$DATA_DISK" ] && break
  echo "waiting for data volume to attach..."; sleep 5
done

if [ -z "$DATA_DISK" ]; then echo "ERROR: metrics volume never appeared"; exit 1; fi

if ! blkid "$DATA_DISK"; then
  echo "no filesystem on $DATA_DISK — first use, formatting"
  mkfs.ext4 -L obsdata "$DATA_DISK"
fi

mkdir -p /data
mount "$DATA_DISK" /data
grep -q "/data" /etc/fstab || echo "LABEL=obsdata /data ext4 defaults,nofail 0 2" >> /etc/fstab

# Per-service data dirs with the uids the upstream images run as.
mkdir -p /data/prometheus /data/grafana
chown 65534:65534 /data/prometheus     # prometheus runs as nobody
chown 472:472 /data/grafana            # grafana runs as uid 472

############################ 2. container runtime ############################
dnf install -y docker
systemctl enable --now docker

############################ 3. prometheus config ###########################
mkdir -p /etc/prometheus

PROM_WEB_CONFIG_ARG=""
%{ if prometheus_enable_basic_auth ~}
# HTTP basic auth for Prometheus. The web.config wants a bcrypt hash, so generate
# it on the box (htpasswd) rather than passing a hash through templating — only
# the plaintext password crosses the template boundary.
dnf install -y httpd-tools
PROM_HASH="$(htpasswd -nbBC 10 '${prometheus_basic_auth_user}' '${prometheus_basic_auth_password}' | cut -d: -f2)"
cat > /etc/prometheus/web.yml <<WEBCFG
basic_auth_users:
  ${prometheus_basic_auth_user}: $PROM_HASH
WEBCFG
PROM_WEB_CONFIG_ARG="--web.config.file=/etc/prometheus/web.yml"
%{ endif ~}

cat > /etc/prometheus/prometheus.yml <<PROM
global:
  scrape_interval: 10s
  evaluation_interval: 10s

scrape_configs:
  - job_name: prometheus
%{ if prometheus_enable_basic_auth ~}
    # Self-scrape goes through basic auth too.
    basic_auth:
      username: ${prometheus_basic_auth_user}
      password: ${prometheus_basic_auth_password}
%{ endif ~}
    static_configs:
      - targets: ['localhost:9090']

  # node_exporter on the test plane (clients + self-managed server when present).
  # The NFS client metrics ride in via node_exporter's mountstats collector.
  - job_name: nfs_fleet
    static_configs:
      - targets: [${scrape_targets_yaml}]
PROM

############################ 4. grafana provisioning ########################
mkdir -p /etc/grafana/provisioning/datasources /etc/grafana/provisioning/dashboards /var/lib/grafana-dashboards

cat > /etc/grafana/provisioning/datasources/prometheus.yml <<DS
apiVersion: 1
datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://localhost:9090
    isDefault: true
%{ if prometheus_enable_basic_auth ~}
    basicAuth: true
    basicAuthUser: ${prometheus_basic_auth_user}
    secureJsonData:
      basicAuthPassword: ${prometheus_basic_auth_password}
%{ endif ~}
DS

cat > /etc/grafana/provisioning/dashboards/harness.yml <<DP
apiVersion: 1
providers:
  - name: harness
    folder: 'NFS Harness'
    type: file
    options:
      path: /var/lib/grafana-dashboards
DP

# A compact starter dashboard: fleet CPU, network throughput, and NFS client op
# rate (from node_exporter mountstats). Enough to SEE load land; explore the
# rest in Grafana directly.
cat > /var/lib/grafana-dashboards/nfs-harness.json <<'DASH'
{
  "title": "NFS Harness — Fleet",
  "uid": "nfs-harness",
  "schemaVersion": 39,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries", "title": "CPU busy % excl iowait (per node)",
      "description": "Real compute load — both idle AND iowait removed, so a disk/network wait can't masquerade as a busy CPU (it did exactly that on the disk-bound run). Pair with the iowait panel below.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [ { "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=~\"idle|iowait\"}[1m])) * 100)", "legendFormat": "{{instance}}" } ]
    },
    {
      "type": "timeseries", "title": "Network receive (bytes/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [ { "expr": "rate(node_network_receive_bytes_total{device!~\"lo\"}[1m])", "legendFormat": "{{instance}} {{device}}" } ]
    },
    {
      "type": "timeseries", "title": "NFS client operations/s (mountstats)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [ { "expr": "sum by (instance) (rate(node_mountstats_nfs_operations_requests_total[1m]))", "legendFormat": "{{instance}}" } ]
    },
    {
      "type": "timeseries", "title": "NFS throughput read+write (bytes/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [ { "expr": "sum by (instance) (rate(node_mountstats_nfs_read_bytes_total[1m]) + rate(node_mountstats_nfs_write_bytes_total[1m]))", "legendFormat": "{{instance}}" } ]
    },
    {
      "type": "timeseries", "title": "Network transmit (bytes/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [ { "expr": "rate(node_network_transmit_bytes_total{device!~\"lo\"}[1m])", "legendFormat": "{{instance}} {{device}}" } ]
    },
    {
      "type": "timeseries", "title": "ENA NIC allowance exceeded (events/s) — >0 means the instance is capped",
      "description": "ENA driver counters from node_exporter's ethtool collector. Any sustained non-zero value means traffic is being shaped by the instance's bandwidth allowance — the NIC, not the workload, is the limit.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "rate(node_ethtool_bw_in_allowance_exceeded[1m])", "legendFormat": "{{instance}} rx-allowance" },
        { "expr": "rate(node_ethtool_bw_out_allowance_exceeded[1m])", "legendFormat": "{{instance}} tx-allowance" }
      ]
    },
    {
      "type": "timeseries", "title": "CPU iowait % (per node)",
      "description": "Time blocked on I/O. High here with low compute = a disk/network bottleneck, not a CPU one.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [ { "expr": "avg by (instance) (rate(node_cpu_seconds_total{mode=\"iowait\"}[1m])) * 100", "legendFormat": "{{instance}}" } ]
    },
    {
      "type": "timeseries", "title": "Disk throughput (bytes/s, read+write per device)",
      "description": "Watch the server's export device flat-top: a ruler-flat ceiling here is a volume throughput cap (gp3 baseline is 125 MB/s unless provisioned higher).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "rate(node_disk_read_bytes_total[1m])", "legendFormat": "{{instance}} {{device}} read" },
        { "expr": "rate(node_disk_written_bytes_total[1m])", "legendFormat": "{{instance}} {{device}} write" }
      ]
    },
    {
      "type": "timeseries", "title": "Disk utilization % (per device)",
      "description": "Fraction of time the device had I/O in flight. ~100% with throughput flat-topped below the device's spec = a provisioned-throughput cap, not a busy disk.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [ { "expr": "rate(node_disk_io_time_seconds_total[1m]) * 100", "legendFormat": "{{instance}} {{device}}" } ]
    },
    {
      "type": "timeseries", "title": "NFS per-op latency (ms) — RTT vs total (gap = client-side queueing)",
      "description": "Server response time (RTT) vs total client-perceived time per op. A large gap means requests are queueing on the client behind a slower resource downstream (disk/NIC), not slow server processing.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "expr": "1000 * rate(node_mountstats_nfs_operations_response_time_seconds_total{operation=~\"READ|WRITE\"}[1m]) / rate(node_mountstats_nfs_operations_requests_total{operation=~\"READ|WRITE\"}[1m])", "legendFormat": "{{instance}} {{operation}} rtt" },
        { "expr": "1000 * rate(node_mountstats_nfs_operations_request_time_seconds_total{operation=~\"READ|WRITE\"}[1m]) / rate(node_mountstats_nfs_operations_requests_total{operation=~\"READ|WRITE\"}[1m])", "legendFormat": "{{instance}} {{operation}} total" }
      ]
    },
    {
      "type": "timeseries", "title": "DIAG · per-client NFS WRITE MB/s (fio laydown phase = write spike)",
      "description": "The phase indicator. fio loops create-files (write-heavy laydown) -> steady randrw, and the five clients drift out of phase. A client riding high here is mid-laydown. Read together with the clip panel on the right: if a client's WRITE spike lines up with its allowance clips, the ENA clipping is buffered-writeback (direct=0) microburst during laydown — not sustained-rate exhaustion (the 1s average stays low). If the heavy set ROTATES across clients over ~10 min, the asymmetry is phase desync between independent loops, not a per-instance defect.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [ { "expr": "sum by (instance) (rate(node_mountstats_nfs_write_bytes_total[1m])) / 1048576", "legendFormat": "{{instance}}" } ]
    },
    {
      "type": "timeseries", "title": "DIAG · per-client tx-allowance clips/s (microburst → ENA token bucket)",
      "description": "node_ethtool_bw_out_allowance_exceeded rate, per client. node_exporter scrapes at 10s so this is a microburst PROXY: the counter accumulates every sub-second clip between scrapes. Correlate spikes here with the WRITE panel on the left (same time axis) and watch whether the heavy set is FIXED to instances (structural) or MIGRATES (phase desync).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [ { "expr": "rate(node_ethtool_bw_out_allowance_exceeded[1m])", "legendFormat": "{{instance}}" } ]
    },
    {
      "type": "timeseries", "title": "DSX · throughput by export — NFSv4.2 host vs NFSv3 portal (bytes/s)",
      "description": "The dual-protocol comparison (dsx_mode runs; empty otherwise). Same clients, same fio workload — the export label splits the host kernel's NFSv4.2 share from the netns-isolated, cgroup-capped NFSv3 portal, so the protocol (plus the portal's deliberate 0.5-CPU cap and forwarded path) is the only variable. First live run: 4.2 ≈ 2× the capped portal.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "targets": [ { "expr": "sum by (export) (rate(node_mountstats_nfs_read_bytes_total[1m]) + rate(node_mountstats_nfs_write_bytes_total[1m]))", "legendFormat": "{{export}}" } ]
    },
    {
      "type": "timeseries", "title": "DSX · NFS operations/s by export — v4.2 vs v3 op-rate shape",
      "description": "Companion to the throughput panel: op RATES by export. v3 and v4.2 decompose the same fio I/O into different operation mixes (v4.2 compounds; v3 needs separate LOOKUP/GETATTR round-trips), so equal byte-throughput does NOT mean equal op-rates — the gap between these panels IS the protocol-efficiency story.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "targets": [ { "expr": "sum by (export) (rate(node_mountstats_nfs_operations_requests_total[1m]))", "legendFormat": "{{export}}" } ]
    }
  ]
}
DASH

############################ 5. run the stack ###############################
# host networking so Grafana reaches Prometheus at localhost:9090 with no extra
# bridge. Data dirs bind to /data (the persistent EBS volume).
docker rm -f prometheus grafana >/dev/null 2>&1 || true

docker run -d --name prometheus --restart unless-stopped --network host \
  -v /etc/prometheus:/etc/prometheus \
  -v /data/prometheus:/prometheus \
  prom/prometheus:latest \
  --config.file=/etc/prometheus/prometheus.yml \
  $PROM_WEB_CONFIG_ARG \
  --storage.tsdb.path=/prometheus

docker run -d --name grafana --restart unless-stopped --network host \
  -e GF_SECURITY_ADMIN_PASSWORD='${grafana_admin_password}' \
  -e GF_USERS_ALLOW_SIGN_UP=false \
  -v /data/grafana:/var/lib/grafana \
  -v /etc/grafana/provisioning:/etc/grafana/provisioning \
  -v /var/lib/grafana-dashboards:/var/lib/grafana-dashboards \
  grafana/grafana:latest

echo "observability bootstrap complete"
